# Line endings for a checkout shared by Windows and WSL: sources, scripts and data LF; figures binary.
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
Makefile* text eol=lf
*.pdf binary
*.png binary
# Round-1 result tables were committed with CRLF; keep their bytes unchanged.
experiments/late_binding/results/*.csv -text
